{
  "manifest_version": 3,
  "name": "JewAI-Alice",
  "version": "1.0.0",
  "description": "Bridge adapter for Alice (alice.yandex.ru) - part of JewAI multimodel.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://alice.yandex.ru/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*",
    "http://127.0.0.1:8770/*",
    "http://127.0.0.1:8771/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://alice.yandex.ru/*"
      ],
      "js": [
        "content_alice.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JewAI-Alice"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}